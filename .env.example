# Скопируйте этот файл в .env и заполните реальными значениями.
# Файл .env никогда не коммитится в git (см. .gitignore).

# Токен Telegram-бота, выданный @BotFather
BOT_TOKEN=

# Строка подключения к PostgreSQL
# Формат: postgresql+asyncpg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/ИМЯ_БАЗЫ
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dateforfamily

# Логин и пароль для входа в админку (веб-страница со списком анкет)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
